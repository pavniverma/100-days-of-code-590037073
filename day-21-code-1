#include <stdio.h>

int main()
{
    int n, first, last, middle, power, result;

    printf("Enter a number: ");
    scanf("%d", &n);

    last = n % 10;

    power = 1;
    while (n / power >= 10)
    {
        power = power * 10;
    }

    first = n / power;

    middle = n % power;
    middle = middle / 10;

    result = last * power + middle * 10 + first;

    printf("Number after swapping first and last digit = %d", result);

    return 0;
}
