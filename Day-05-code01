#include <stdio.h>
#include <math.h>
int main() {
    float principal, rate, time, SI, Am,  CI;
    printf("enter the principal amount:");
    scanf("%f", &principal);
    printf("enter the rate:");
    scanf("%f",&rate);
    printf("enter the number of years:");
    scanf("%f",&time);
    SI= (principal*time*rate)/100;
    Am= principal * pow((1+ rate/(100*time)), time);
    CI = Am - principal;
    printf("SI= %.2f\n CI =%.2f", SI , CI);

    return 0;


}
