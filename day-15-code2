//write a program to reverse a given number
#include <stdio.h>
int main()
{
  int number, digit;
  int reverse =0;
  printf("enter the number:");
  scanf("%d", &number);

  while(number>0)
  {
    digit= number%10;
    reverse = reverse*10 + digit;
    number /=10;
  }
  printf("reversed number = %d\n", reverse);
  return 0;
}
