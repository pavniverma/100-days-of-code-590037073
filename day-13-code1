#include <stdio.h>

int main() {
    int num1, num2, choice;

    scanf("%d %d", &num1, &num2);
    scanf(" %c", &choice);

    switch (choice) {
        case '+':
            printf("%d", num1 + num2);
            break;

        case '-':
            printf("%d", num1 - num2);
            break;

        case '*':
            printf("%d", num1 * num2);
            break;

        case '/':
            printf("%d", num1 / num2);
            break;

        case '%':
            printf("%d", num1 % num2);
            break;

        default:
            printf("Invalid operator");
    }

    return 0;
}
