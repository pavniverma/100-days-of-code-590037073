#include <stdio.h>
#include <math.h>

int main() {
    float a, b, c, D, root1, root2;
    scanf("%f %f %f", &a, &b, &c);
    D = b*b - 4*a *c;
    if(D>0)
    {
        root1 = (-b +sqrt(D))/(2*a);
        root2 = (-b - sqrt(D))/(2*a);
        printf("Roots are real and distinct\n");
        printf("Root1 = %.2f\n", root1);
        printf("Root2 = %.2f\n", root2);
        else if(D==0)
        {
            root1 = -b/(2*a);
            printf("roots are real and equal\n");
            printf("root1 = root2 = .2%f\n", root1);
        }
        else 
        { printf("Roots are complex\n");}
        }
    }

    return 0;

}
